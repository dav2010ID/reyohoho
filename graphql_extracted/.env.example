# Основной сервер
HOST=0.0.0.0
PORT=8000
KINOPOISK_PROVIDER=graphql
CACHE_MAX_ENTRIES=5000

# Рабочие API-провайдеры
COLLAPS_TOKEN=
ALLOHA_TOKEN=
TMDB_TOKEN=
YOUTUBE_TOKEN=

# Необязательный прямой Alloha fallback
BEFRIEND_TOKEN=

# Vibix сейчас возвращает метаданные, но не iframe_url
VIBIX_TOKEN=

# Один шаблон на строку. Обязательно используйте /embed/kp/{kp_id},
# потому что /embed/movie/{kp_id} принимает внутренний ID провайдера.
KP_EMBED_SOURCES="https://api1690380040.atomics.ws/embed/kp/{kp_id}
https://api.atomics.ws/embed/kp/{kp_id}
https://api.marts.ws/embed/kp/{kp_id}
https://api.domem.ws/embed/kp/{kp_id}
https://api.embess.ws/embed/kp/{kp_id}
https://api.namy.ws/embed/kp/{kp_id}"

OBRUT_EMBED_URL=https://5414e3c9.obrut.show/embed/kDN?kinopoisk_id={kp_id}

# Старые провайдеры отключены по умолчанию; можно задать новые доступы вручную.
KODIK_TOKEN=
BAZON_TOKEN=
VIDEOCDN_TOKEN=
HDVB_TOKEN=
LUMEX_TOKEN=
CDNMOVIES_TOKEN=
