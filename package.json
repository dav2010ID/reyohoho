    "sass-embedded": "^1.98.0",
    "sharp": "^0.35.5",
    "vite": "8.0.16",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.0",
    "workbox-build": "^7.4.1",
    "wrangler": "^4.160.0"
  },
  "resolutions": {
    "**/follow-redirects": "1.16.3",
    "**/filelist/minimatch": "5.1.8",
    "**/axios/form-data": "4.0.6",
    "**/defu": "6.1.5",
    "**/fast-uri": "3.1.8",
