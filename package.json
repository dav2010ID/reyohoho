{
  "name": "reyohoho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "seo:fetch": "node scripts/fetch-seo-data.js",
    "seo:assets": "node scripts/generate-seo-assets.js",
    "seo:prepare": "node scripts/fetch-seo-data.js && node scripts/generate-seo-assets.js",
    "postbuild:gh-pages": "node scripts/postbuild-gh-pages.js",
    "build": "vite-ssg build && node scripts/postbuild-gh-pages.js",
    "build:github": "cross-env VITE_BASE_URL=/reyohoho/ vite-ssg build --mode github && cross-env VITE_BASE_URL=/reyohoho/ node scripts/postbuild-gh-pages.js",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint --ext .js,.vue src",
    "lint:fix": "eslint --ext .js,.vue src --fix",
    "check:encoding": "node scripts/check-encoding-artifacts.js",
    "format": "prettier --write src/",
    "perf:browser": "node scripts/browser-performance-check.js",
    "test:browser-smoke": "node scripts/browser-smoke-check.js",
    "test:infinite-scroll": "node scripts/browser-infinite-scroll-check.js",
    "profile:cards": "node scripts/browser-card-profile.js",
    "icons": "node scripts/generate-icons.js",
    "icons:material": "node scripts/generate-material-icons.js",
    "build:icons": "node scripts/generate-icons.js && vite-ssg build && node scripts/postbuild-gh-pages.js"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@unhead/vue": "^2.1.13",
    "axios": "^1.18.1",
    "dompurify": "^3.4.11",
    "firebase": "^12.16.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode.vue": "^3.8.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue": "3.5.39",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^5.1.0",
    "vue3-cookies": "^1.0.6",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/test-utils": "2.4.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.1",
    "sass-embedded": "^1.98.0",
    "sharp": "^0.34.5",
    "vite": "8.0.0",
    "vite-plugin-eslint": "^1.8.1",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.4.0"
  },
  "resolutions": {
    "**/filelist/minimatch": "5.1.8",
    "**/axios/form-data": "4.0.6",
    "**/@grpc/grpc-js": "1.9.16",
    "**/protobufjs": "7.6.3",
    "**/@protobufjs/utf8": "1.1.1",
    "**/defu": "6.1.5",
    "**/fast-uri": "3.1.2",
    "**/@babel/core": "7.29.6",
    "**/@babel/plugin-transform-modules-systemjs": "7.29.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
