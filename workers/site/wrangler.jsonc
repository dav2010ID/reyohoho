{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "reyohoho-site",
  "main": "src/index.mjs",
  "compatibility_date": "2026-11-10",
  // The workers.dev URL is the preview before the switch and stays after it (noindex via _headers).
  // reyhoho.fun is attached with `--domain` at deploy time (docs/cloudflare-site.md), not here.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    // Prerendered pages are directories: /movie/301/slug/ is canonical.
    "html_handling": "auto-trailing-slash",
    // Misses go to the Worker, which decides 301 / 200 noindex / real 404.
    "not_found_handling": "none"
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
